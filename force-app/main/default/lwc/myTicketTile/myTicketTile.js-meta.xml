<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <isExposed>true</isExposed>

    <targets>
        <!-- Home Page Builder -->
        <target>lightning__HomePage</target>

        <!-- App Page (custom Lightning page) -->
        <target>lightning__AppPage</target>

        <!-- Record Page (if you want it on Case or other Objects) -->
        <target>lightning__RecordPage</target>

        <!-- Utility bar (optional) -->
        <target>lightning__UtilityBar</target>
    </targets>

    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Case</object>
                <object>support_ticket__c</object>
                <object>Salesforce__c</object>
                <object>Status_Tracker__c</object>
            </objects>
        </targetConfig>

        <targetConfig targets="lightning__HomePage">
            <supportedFormFactors>
                <supportedFormFactor type="Large"/> <!-- Desktop -->
                <supportedFormFactor type="Small"/> <!-- Phone -->
            </supportedFormFactors>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>